{
  "name": "recall-record",
  "private": true,
  "version": "0.1.0",
  "description": "A weekly visual record of US consumer product recalls, built from CPSC public-domain data.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "data": "node scripts/build-data.mjs",
    "dev": "vite",
    "build": "npm run data && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.6"
  }
}
